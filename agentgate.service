[Unit]
Description=AgentGate - Secure AI Agent Privilege & Command Execution Bridge
After=network.target
Documentation=https://github.com/agentgate/agentgate

[Service]
Type=simple
ExecStart=/usr/local/bin/agentgate serve
Restart=on-failure
RestartSec=5s

# Dedicated service user and group
User=agentgate
Group=agentgate

# Process & execution sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
KeyringMode=private
RemoveIPC=true
UMask=0077

# Bounded capabilities for OS user switching (Phase 2)
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE

# Sandboxed filesystem paths (only config, log, and runtime tokens)
ReadWritePaths=/etc/agentgate /var/log/agentgate

# System call filtering
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

