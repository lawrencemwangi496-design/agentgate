[Unit]
Description=AgentGate - Secure AI Agent Privilege & Command Execution Bridge
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agentgate serve
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/etc/agentgate /var/log/agentgate

[Install]
WantedBy=multi-user.target
